{
  "version": 2,
  "buildCommand": "echo 'build complete'",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "memory": 512
    }
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "index.html",
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/?(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/uploads/?(.*)",
      "dest": "public/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}
